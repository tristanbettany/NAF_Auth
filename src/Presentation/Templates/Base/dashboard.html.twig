{% extends '@Base/Layouts/dashboard_layout.html.twig' %}

{% block body %}
    <div class="mt-50px">
        <h1 class="text-40px mb-20px">NAF Dashboard</h1>
        <a href="/logout" class="bg-sky-500 px-20px py-9px text-white">Logout</a>
    </div>

    <div class="mt-50px">
        <p class="text-40px mb-20px">User Profile:</p>
        <p>First Name: {{ user.firstName }}</p>
        <p>First Last Name: {{ user.lastName }}</p>
        <p>First Email: {{ user.email }}</p>
        <p>First SSO ID: {{ user.ssoId }}</p>
    </div>
{% endblock %}